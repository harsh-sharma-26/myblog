<%# [LOADER] Full-screen loader. Header har page me sabse pehle include hota hai, isliye loader har page ke body me sabse upar aata hai.
    Ye normally hidden rehta hai; loader.js "is-loading" class lagati hai tab dikhta hai, aur site khulne pe hata deti hai. Styling: public/styles/loader.css %>
<div id="page-loader" aria-hidden="true">
  <span class="loader-blob loader-blob-1"></span>
  <span class="loader-blob loader-blob-2"></span>
  <div class="loader-ring"><span class="loader-logo">M</span></div>
  <p class="loader-text">MyBlog</p>
  <div class="loader-bar"><span class="loader-bar-fill"></span></div>
</div>
<header id="main-header">
  <div id="logo">
    <a href="/">MyBlog</a>
  </div>
  <nav>
    <ul>
      <li>
        <a href="/posts">All Posts</a>
      </li>
      <%# [AUTH] Navbar login ki halat ke hisaab se badalta hai. `locals.currentUser` (seedha currentUser nahi) isliye ki
          kabhi error page aise mauke pe render ho jab user load hi nahi hua tha, tab bhi EJS crash na kare. %>
      <% if (locals.currentUser) { %>
      <li>
        <a href="/new-post">Create Post</a>
      </li>
      <li class="nav-user">
        <span class="nav-user-name"><%= currentUser.name %></span>
        <% if (currentUser.type === 'admin') { %><span class="role-badge">Admin</span><% } %>
      </li>
      <li>
        <%# Logout GET link nahi, POST form hai (CSRF token ke saath), warna koi bhi image tag se user ko logout karwa deta %>
        <form class="logout-form" action="/logout" method="POST">
          <%- include('csrf-field') %>
          <button type="submit" class="logout-button">Logout</button>
        </form>
      </li>
      <% } else { %>
      <li>
        <a href="/login">Login</a>
      </li>
      <li>
        <a href="/signup">Sign up</a>
      </li>
      <% } %>
      <li>
        <%# [UI REDESIGN] Light/Dark toggle button. Dono icons yahan hain, base.css decide karti hai kaun sa dikhe. Click ka logic public/scripts/theme.js me hai %>
        <button id="theme-toggle" type="button" aria-label="Switch theme">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </li>
    </ul>
  </nav>
</header>
