<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<%# [UI REDESIGN] theme-color: phone browser ki address bar ka color site ke purple se match karta hai %>
<meta name="theme-color" content="#6a3df0">
<title>
  <%= title %>
</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<%# [UI REDESIGN] Inter = body text ka modern font, Roboto Slab = headings ka font %>
<%# [PERF] Font CSS render-blocking tha. media="print" + onload trick se ab page ko block nahi karta (noscript = JS band ho tab fallback) %>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Slab:wght@400;700&display=swap"
  rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Slab:wght@400;700&display=swap" rel="stylesheet"></noscript>
<%# [AUTH - CSRF] Like button jaise fetch() requests form nahi bhejte, to unhe token header me dena padta hai. LikeButton.jsx isi meta tag se token padhta hai. %>
<% if (locals.csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
<link rel="stylesheet" href="/styles/base.css">
<%# [LOADER] loader ki styling. head me hai taaki pehle paint se pehle ready ho %>
<link rel="stylesheet" href="/styles/loader.css">
<%# [UI REDESIGN] theme.js jaanboojh ke bina defer ke hai: saved dark/light theme page dikhne se PEHLE lag jaye, white flash na aaye %>
<script src="/scripts/theme.js"></script>
<%# [LOADER] Loader ka logic (setTimeout se site rokta hai). theme.js ke BAAD hona zaruri hai taaki loader sahi theme ke colors me dikhe %>
<script src="/scripts/loader.js"></script>
