<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head', { title: 'Update post' }) %>
    <link rel="stylesheet" href="/styles/forms.css" />
  </head>

  <body>
    <%- include('includes/header') %>
    <main>
      <h1>Update post</h1>
      <%# [FIX #2] action ke end me jo extra space tha wo hata diya %>
      <form action="/posts/<%= post.id %>/edit" method="POST">
        <%- include('includes/csrf-field') %>
        <div class="form-control">
          <label for="title">Title</label>
          <input
            type="text"
            id="title"
            value="<%= post.title %>"
            name="title"
            required
            maxlength="255"
          />
        </div>
        <div class="form-control">
          <label for="summary">Summary</label>
          <%# [FIX #2] value ke end ka extra space hata diya, warna har edit pe space save hota tha %>
          <input
            type="text"
            id="summary"
            value="<%= post.summary %>"
            name="summary"
            required
            maxlength="255"
          />
        </div>
        <div class="form-control">
          <label for="content">Post Content</label>
          <%# [FIX #2] textarea ke andar bhi extra space/newline nahi hona chahiye, isliye sab ek line me hai %>
          <textarea id="content" name="content" required rows="5"><%= post.body %></textarea>
        </div>
        <%# [AUTH] Edit me author dropdown nahi hai: post ka owner kabhi nahi badalta (admin kisi ki post edit kare tab bhi) %>
        <button class="btn">Update Post</button>
      </form>
    </main>
  </body>
</html>
