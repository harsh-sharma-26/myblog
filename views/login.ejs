<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('includes/head', { title: 'Login' }) %>
    <link rel="stylesheet" href="/styles/forms.css" />
  </head>

  <body>
    <%- include('includes/header') %>
    <main>
      <h1>Login</h1>
      <form action="/login" method="POST">
        <%- include('includes/csrf-field') %>
        <%- include('includes/form-error') %>
        <%# `next` = login ke baad kahan wapas bhejna hai (routes/auth.js safeNextPath se already check hota hai, sirf apni site ka path). Khali ho to chhupa field banta hi nahi. %>
        <% if (locals.next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
        <div class="form-control">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= locals.email || '' %>" required maxlength="255" autocomplete="email" />
        </div>
        <div class="form-control">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password" />
        </div>
        <button class="btn">Login</button>
        <p class="form-alt">Naye ho? <a href="/signup">Account banao</a></p>
        <p class="form-alt">Author / Admin ho? <a href="/admin/login">Admin login</a></p>
      </form>
    </main>
  </body>
</html>
